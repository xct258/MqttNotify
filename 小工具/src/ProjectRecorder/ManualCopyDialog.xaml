<Window x:Class="ProjectRecorder.ManualCopyDialog" FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手动复制网址" Height="300" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
    <StackPanel Margin="20">
        <TextBlock Text="网址（已全选：直接按 Ctrl+C，或点下方“复 制”）" FontSize="13"
                   FontWeight="Bold" Foreground="#374151"/>
        <TextBox x:Name="TxtContent" Height="90" Margin="0,8,0,0" TextWrapping="Wrap"
                 IsReadOnly="True" VerticalScrollBarVisibility="Auto" Padding="6,4"
                 GotFocus="TxtContent_GotFocus"/>
        <TextBlock x:Name="TxtStatus" FontSize="12" Margin="0,6,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button Content="复 制" Width="96" Style="{StaticResource BtnPrimary}" Click="BtnCopy_Click" IsDefault="True"/>
            <Button Content="关 闭" Width="96" Margin="12,0,0,0" Style="{StaticResource BtnGhost}"
                    Click="BtnClose_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
