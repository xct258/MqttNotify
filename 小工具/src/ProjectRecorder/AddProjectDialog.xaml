<Window x:Class="ProjectRecorder.AddProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加项目" Height="200" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
    <StackPanel Margin="20">
        <TextBlock Text="项目名称 *" FontSize="13" FontWeight="Bold" Foreground="#374151"/>
        <TextBox x:Name="TxtName" Height="32" Margin="0,8,0,0" VerticalContentAlignment="Center" MaxLength="100"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="确 定" Width="96" Style="{StaticResource BtnPrimary}" Click="BtnOk_Click" IsDefault="True"/>
            <Button Content="取 消" Width="96" Margin="12,0,0,0" Style="{StaticResource BtnGhost}" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
