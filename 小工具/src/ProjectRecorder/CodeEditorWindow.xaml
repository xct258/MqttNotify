<Window x:Class="ProjectRecorder.CodeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:ProjectRecorder"
        Title="在线编辑" Height="640" Width="920" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E" Icon="app.ico"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <!-- Ctrl+S 保存 -->
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save"
                        Executed="SaveCommand_Executed" CanExecute="SaveCommand_CanExecute"/>
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Command="ApplicationCommands.Save" Key="S" Modifiers="Ctrl"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- 深色次按钮：仿 VS Code 工具栏按钮（覆盖应用级白底浅色 BtnGhost 只在主窗口用） -->
        <Style x:Key="EditorGhost" TargetType="Button">
            <Setter Property="Background" Value="#3A3D41"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45494E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2D2F33"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#2D2F33"/>
                                <Setter Property="Foreground" Value="#808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 深色滚动条：覆盖应用级浅色滚动条（仅本窗口生效） -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="24" MinWidth="12">
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Background" Value="#4D4D52"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="1"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#606066"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter Property="Background" Value="#80808A"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="MinHeight" Value="12"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 横竖滚动条交界处的补角默认取系统 Control 色，深色主题下会露出浅色方块；
             这里直接把该资源键覆盖为编辑器底色，不改动 ScrollViewer 模板本身 -->
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1E1E1E"/>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：文件名 + 语言/编码 + 操作按钮 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="TxtFileName" FontSize="14" FontWeight="Bold"
                           Foreground="#D4D4D4" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TxtFileInfo" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="ChkPreview" Content="预览" FontSize="12" Foreground="#9CA3AF"
                          VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"
                          Checked="ChkPreview_Changed" Unchecked="ChkPreview_Changed"
                          ToolTip="Markdown 实时预览"/>
                <CheckBox x:Name="ChkDocs" Content="资料" FontSize="12" Foreground="#9CA3AF"
                          VerticalAlignment="Center" Margin="0,0,12,0"
                          Checked="ChkDocs_Changed" Unchecked="ChkDocs_Changed"
                          ToolTip="查看 sh / py / md 中文速查文档"/>
                <Button Content="保 存" Width="86" Style="{StaticResource BtnPrimary}"
                        Click="BtnSave_Click" ToolTip="Ctrl+S"/>
                <Button Content="关 闭" Width="86" Margin="8,0,0,0" Style="{StaticResource EditorGhost}"
                        Click="BtnClose_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>

        <!-- 查找 / 替换面板（Ctrl+F 打开，Ctrl+H 定位到替换框） -->
        <Border x:Name="FindPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,8"
                Background="#252526" BorderBrush="#3A3D41" BorderThickness="1" CornerRadius="6"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,6">
                    <TextBlock Text="查找" Width="34" FontSize="12" Foreground="#9CA3AF"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtFind" FontSize="13" Height="26"
                             TextChanged="TxtFind_TextChanged" KeyDown="TxtFind_KeyDown"/>
                </DockPanel>

                <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="替换" Width="34" FontSize="12" Foreground="#9CA3AF"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtReplace" FontSize="13" Height="26"
                             KeyDown="TxtReplace_KeyDown"/>
                </DockPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkCase" Content="Aa" FontSize="12" Foreground="#9CA3AF"
                              VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="区分大小写"
                              Checked="FindOption_Changed" Unchecked="FindOption_Changed"/>
                    <CheckBox x:Name="ChkWhole" Content="全字" FontSize="12" Foreground="#9CA3AF"
                              VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="全字匹配"
                              Checked="FindOption_Changed" Unchecked="FindOption_Changed"/>
                    <CheckBox x:Name="ChkRegex" Content=".*" FontSize="12" Foreground="#9CA3AF"
                              VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="正则表达式"
                              Checked="FindOption_Changed" Unchecked="FindOption_Changed"/>
                    <Button Content="上一个" Style="{StaticResource EditorGhost}"
                            Click="FindPrev_Click" Margin="0,0,6,0"/>
                    <Button Content="下一个" Style="{StaticResource EditorGhost}"
                            Click="FindNext_Click" Margin="0,0,6,0"/>
                    <Button Content="关闭" Style="{StaticResource EditorGhost}"
                            Click="FindClose_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtFindResult" FontSize="12" Foreground="#9CA3AF"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="替换" Style="{StaticResource EditorGhost}"
                            Click="ReplaceOne_Click" Margin="0,0,6,0"/>
                    <Button Content="全部替换" Style="{StaticResource EditorGhost}"
                            Click="ReplaceAll_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 编辑器：AvalonEdit，行号 + VS Code Dark+ 风格语法高亮；md 可右侧实时预览 -->
        <Border Grid.Row="2" Background="#1E1E1E" BorderBrush="#303031"
                BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition x:Name="PreviewSplitterCol" Width="0"/>
                    <ColumnDefinition x:Name="PreviewCol" Width="0"/>
                </Grid.ColumnDefinitions>
                <avalonedit:TextEditor x:Name="Editor" Grid.Column="0"
                                       FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                                       FontSize="14"
                                       ShowLineNumbers="True"
                                       HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Hidden"/>
                <!-- 右侧简化缩略条：按行长度画色条，显示/拖动可视区域 -->
                <local:OverviewBar x:Name="Overview" Grid.Column="1" Width="56"
                                   Cursor="Hand" ToolTip="代码缩略条：点击/拖动可定位"/>
                <GridSplitter x:Name="PreviewSplitter" Grid.Column="2" Width="4"
                              HorizontalAlignment="Stretch" Background="#303031" Visibility="Collapsed"/>
                <Border x:Name="PreviewPane" Grid.Column="3" Background="#1E1E1E" Visibility="Collapsed">
                    <WebBrowser x:Name="PreviewBrowser"/>
                </Border>
                <!-- 资料面板：sh / py / md 中文速查文档 -->
                <Border x:Name="DocPane" Grid.Column="3" Background="#1E1E1E" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="中文速查资料" FontSize="13" FontWeight="Bold"
                                   Foreground="#D4D4D4" Margin="10,8,10,2"/>

                        <Grid Grid.Row="1" Margin="10,4,10,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbDocLang" Grid.Column="0" Width="96" Height="26"
                                      SelectionChanged="CmbDocLang_SelectionChanged">
                                <ComboBoxItem Content="Shell"/>
                                <ComboBoxItem Content="Python"/>
                                <ComboBoxItem Content="Markdown"/>
                            </ComboBox>
                            <ComboBox x:Name="CmbDocSection" Grid.Column="1" Height="26" Margin="8,0,0,0"
                                      ToolTip="跳转到章节"
                                      SelectionChanged="CmbDocSection_SelectionChanged"/>
                        </Grid>

                        <Grid Grid.Row="2" Margin="10,0,10,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtDocSearch" Grid.Column="0" Height="26" FontSize="13"
                                     ToolTip="在本页查找（回车下一个）"
                                     TextChanged="TxtDocSearch_TextChanged" KeyDown="TxtDocSearch_KeyDown"/>
                            <Button x:Name="BtnDocPrev" Grid.Column="1" Content="▲" Width="34" Height="26"
                                    Margin="6,0,0,0" Style="{StaticResource EditorGhost}"
                                    Click="DocPrev_Click" ToolTip="上一处"/>
                            <Button x:Name="BtnDocNext" Grid.Column="2" Content="▼" Width="34" Height="26"
                                    Margin="6,0,0,0" Style="{StaticResource EditorGhost}"
                                    Click="DocNext_Click" ToolTip="下一处"/>
                            <TextBlock x:Name="TxtDocSearchResult" Grid.Column="3" FontSize="11"
                                       Foreground="#9CA3AF" VerticalAlignment="Center"
                                       Margin="8,0,0,0" MinWidth="44"/>
                        </Grid>

                        <WebBrowser x:Name="DocBrowser" Grid.Row="3"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 状态栏：光标位置 + 超宽提示 + 字号/语言/编码/修改状态 -->
        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtCursor" Grid.Column="0" FontSize="11" Foreground="#9CA3AF"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtOverflow" Grid.Column="1" FontSize="11" Foreground="#F59E0B"
                       VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed"
                       Text="代码超出显示宽度，可左右滚动查看"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtZoom" FontSize="11" Foreground="#9CA3AF" Margin="0,0,12,0"/>
                <TextBlock x:Name="TxtMeta" FontSize="11" Foreground="#9CA3AF"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>