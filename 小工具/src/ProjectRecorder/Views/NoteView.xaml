<UserControl x:Class="ProjectRecorder.Views.NoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 通用入口：笔记（左列笔记列表，右侧标题 + 正文编辑，自动保存） -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="笔记列表" FontSize="13" FontWeight="Bold" Foreground="#374151"
                           VerticalAlignment="Center"/>
                <Button x:Name="BtnAddNote" Content="＋ 新建笔记"
                        HorizontalAlignment="Right" Style="{StaticResource BtnPrimary}"
                        Click="BtnAddNote_Click"/>
            </Grid>
            <Grid Grid.Row="1">
                <TextBlock x:Name="TxtNoteEmpty" Text="暂无笔记，点上方“＋ 新建笔记”"
                           Style="{StaticResource EmptyText}" TextWrapping="Wrap"
                           Margin="10" Visibility="Collapsed"/>
                <ListBox x:Name="LstNotes" SelectionMode="Single"
                         Style="{StaticResource CleanList}"
                         SelectionChanged="LstNotes_SelectionChanged"
                         PreviewMouseRightButtonDown="LstNotes_RightButtonDown"
                         PreviewMouseRightButtonUp="ListBlankUp"
                         ScrollViewer.CanContentScroll="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="删除该笔记" Click="MenuDeleteNote_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,3" Padding="10,8" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="14"
                                               FontWeight="Bold" Foreground="#1F2937"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="11" Foreground="#6B7280" Margin="0,2,0,0">
                                        <Run Text="{Binding UpdatedTime, Mode=OneWay, StringFormat=MM-dd HH:mm}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <Border Grid.Column="1" BorderBrush="#E5E7EB" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtNoteTitle" Grid.Column="0" Height="32"
                             FontSize="15" FontWeight="Bold" MaxLength="100"
                             VerticalContentAlignment="Center"
                             TextChanged="NoteText_Changed"/>
                    <Button x:Name="BtnDeleteNote" Grid.Column="1" Content="删 除" Height="30"
                            Margin="8,0,0,0" Style="{StaticResource BtnGhost}"
                            Click="MenuDeleteNote_Click"/>
                </Grid>
                <Grid Grid.Row="1" Margin="14,0,14,0">
                    <TextBox x:Name="TxtNoteBody" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                             Padding="8,6" TextChanged="NoteText_Changed"/>
                    <TextBlock x:Name="TxtNoteNoSel" Text="请从左侧选择或新建笔记"
                               Style="{StaticResource EmptyText}"/>
                </Grid>
                <TextBlock x:Name="TxtNoteStatus" Grid.Row="2" Margin="14,4,14,8"
                           FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
