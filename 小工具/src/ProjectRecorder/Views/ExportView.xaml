<UserControl x:Class="ProjectRecorder.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 通用入口：导出合计 Excel（单日 / 日期范围批量） -->
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="单日导出：默认本班次，选日期后导出该日期合计" FontSize="12"
                       Foreground="#6B7280" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <Button x:Name="ExpPrevDay" Content="◀" Width="30" Height="30"
                        Style="{StaticResource BtnStep}" Click="ExpPrevDay_Click"/>
                <Button x:Name="ExpPickDate" Width="130" Height="30" Margin="6,0,0,0"
                        Style="{StaticResource BtnGhost}" Click="ExpPickDate_Click"/>
                <Popup x:Name="ExpPopCalendar" PlacementTarget="{Binding ElementName=ExpPickDate}"
                       Placement="Bottom" StaysOpen="False">
                    <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                            CornerRadius="6" Padding="6">
                        <Calendar x:Name="ExpCal" SelectionMode="SingleDate"
                                  SelectedDatesChanged="ExpCal_SelectedDatesChanged"/>
                    </Border>
                </Popup>
                <Button x:Name="ExpNextDay" Content="▶" Width="30" Height="30" Margin="6,0,0,0"
                        Style="{StaticResource BtnStep}" Click="ExpNextDay_Click"/>
            </StackPanel>
            <Button x:Name="BtnExport" Content="导 出 Excel" Width="150" Height="36" Margin="0,20,0,0"
                    Style="{StaticResource BtnPrimary}" Click="BtnExport_Click"/>

            <Border Height="1" Background="#E5E7EB" Width="420" Margin="0,26,0,0"/>

            <TextBlock Text="批量导出：选择日期范围，生成 汇总 / 每日汇总 / 明细 三个工作表"
                       FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center"
                       Margin="0,16,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <TextBlock Text="开始" FontSize="12" Foreground="#374151"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker x:Name="BatchStart" Width="130" Height="30"
                            VerticalContentAlignment="Center"/>
                <TextBlock Text="结束" FontSize="12" Foreground="#374151"
                           VerticalAlignment="Center" Margin="12,0,6,0"/>
                <DatePicker x:Name="BatchEnd" Width="130" Height="30"
                            VerticalContentAlignment="Center"/>
                <ComboBox x:Name="BatchShift" Width="96" Height="30" Margin="12,0,0,0"
                          VerticalContentAlignment="Center">
                    <ComboBoxItem Content="全部班次" IsSelected="True"/>
                    <ComboBoxItem Content="白班"/>
                    <ComboBoxItem Content="夜班"/>
                </ComboBox>
            </StackPanel>
            <Button x:Name="BtnBatchExport" Content="批量导出 Excel" Width="150" Height="36"
                    Margin="0,16,0,0" Style="{StaticResource BtnPrimary}"
                    Click="BtnBatchExport_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
