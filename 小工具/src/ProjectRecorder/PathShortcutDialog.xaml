<Window x:Class="ProjectRecorder.PathShortcutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加快捷路径" Width="460" SizeToContent="Height" MinHeight="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
    <StackPanel Margin="20">
        <TextBlock Text="名称 *" FontSize="13" FontWeight="Bold" Foreground="#374151"/>
        <TextBox x:Name="TxtName" Height="32" Margin="0,8,0,0" VerticalContentAlignment="Center" MaxLength="50"/>

        <TextBlock x:Name="TxtKindLabel" Text="类型 *" FontSize="13" FontWeight="Bold"
                   Foreground="#374151" Margin="0,14,0,0"/>
        <StackPanel x:Name="KindPanel" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
            <RadioButton x:Name="RdoFolder" Content="文件夹" GroupName="ShortcutKind"
                         IsChecked="True" Checked="Kind_Changed"/>
            <RadioButton x:Name="RdoUrl" Content="网址" GroupName="ShortcutKind"
                         Margin="18,0,0,0" Checked="Kind_Changed"/>
        </StackPanel>

        <TextBlock x:Name="TxtTargetLabel" Text="文件夹路径 *" FontSize="13" FontWeight="Bold"
                   Foreground="#374151" Margin="0,12,0,0"/>
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtPath" Grid.Column="0" Height="32" VerticalContentAlignment="Center"/>
            <Button x:Name="BtnBrowse" Grid.Column="1" Content="浏览…" Width="80" Margin="8,0,0,0"
                    Style="{StaticResource BtnGhost}" Click="BtnBrowse_Click"/>
        </Grid>
        <TextBlock x:Name="TxtHint" Text="例：https://www.example.com（也可直接输 www.example.com）"
                   FontSize="12" Foreground="#9CA3AF" Margin="0,6,0,0" TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="确 定" Width="96" Style="{StaticResource BtnPrimary}" Click="BtnOk_Click" IsDefault="True"/>
            <Button Content="取 消" Width="96" Margin="12,0,0,0" Style="{StaticResource BtnGhost}" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
