<Window x:Class="ProjectRecorder.StepDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ProjectRecorder.Converters"
        Title="操作步骤" Height="540" Width="520" MinHeight="440" MinWidth="420"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC">
    <Window.Resources>
        <conv:StepImageToThumbConverter x:Key="StepImageThumb"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="步骤内容 *" FontSize="13" FontWeight="Bold" Foreground="#374151"/>
                <TextBox x:Name="TxtStep" Height="96" Margin="0,8,0,0" VerticalContentAlignment="Top" MaxLength="500"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0" VerticalAlignment="Center">
                    <TextBlock Text="配图" FontSize="13" FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center"/>
                    <Button x:Name="BtnPickImage" Content="插入图片…" Width="104" Margin="12,0,0,0" Style="{StaticResource BtnGhost}" Click="BtnPickImage_Click"/>
                    <TextBlock Text="可多选，单张≤5MB" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel x:Name="PanelImagePreview" Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="TxtImageInfo" FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                    <ListBox x:Name="LstImages" Margin="0,6,0,0" Style="{StaticResource CleanList}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="4"
                                        Margin="0,0,8,8" Background="White">
                                    <Grid>
                                        <Image Source="{Binding Converter={StaticResource StepImageThumb}}"
                                               Width="110" Height="80" Stretch="Uniform"/>
                                        <Button Content="×" Width="22" Height="22" HorizontalAlignment="Right"
                                                VerticalAlignment="Top" Style="{StaticResource BtnStep}"
                                                Click="BtnRemoveImage_Click" ToolTip="移除该图"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Button Content="确 定" Width="96" Style="{StaticResource BtnPrimary}" Click="BtnOk_Click" IsDefault="True"/>
            <Button Content="取 消" Width="96" Margin="12,0,0,0" Style="{StaticResource BtnGhost}" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
