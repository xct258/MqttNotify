<Window x:Class="ProjectRecorder.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录" Height="300" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F1F5F9" Icon="app.ico">
    <Border Background="White" CornerRadius="12" Padding="30,24" Margin="18"
            BorderBrush="#E5E7EB" BorderThickness="1">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="密码：" FontSize="13" Foreground="#374151" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PwdBox" Height="34"/>
            <CheckBox x:Name="ChkRemember" Margin="0,10,0,0" FontSize="12" Foreground="#374151"
                      Content="保存登录"/>
            <TextBlock x:Name="TxtError" Foreground="#DC2626" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <Button x:Name="BtnLogin" Content="登 录" Height="38" Margin="0,12,0,0"
                    Style="{StaticResource BtnPrimary}" Click="BtnLogin_Click" IsDefault="True"/>
        </StackPanel>
    </Border>
</Window>
