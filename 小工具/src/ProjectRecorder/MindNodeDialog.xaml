<Window x:Class="ProjectRecorder.MindNodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑节点" Height="460" Width="520" MinHeight="380" MinWidth="420"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="标题 *（显示在导图上）" FontSize="13" FontWeight="Bold" Foreground="#374151"/>
        <TextBox x:Name="TxtTitle" Grid.Row="1" Height="32" Margin="0,8,0,0"
                 VerticalContentAlignment="Center" MaxLength="100"/>

        <TextBlock Grid.Row="2" Text="内容（画布不显示，可多行；Ctrl+Enter 确定）" FontSize="13"
                   FontWeight="Bold" Foreground="#374151" Margin="0,14,0,0"/>
        <TextBox x:Name="TxtContent" Grid.Row="3" Margin="0,8,0,0" MinHeight="180"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto" Padding="6,4"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button Content="确 定" Width="96" Style="{StaticResource BtnPrimary}" Click="BtnOk_Click" IsDefault="True"/>
            <Button Content="取 消" Width="96" Margin="12,0,0,0" Style="{StaticResource BtnGhost}"
                    Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
