<Window x:Class="ProjectRecorder.GroupPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择分组" Height="430" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="选择分组 *" FontSize="13" FontWeight="Bold" Foreground="#374151"/>

        <Border Grid.Row="1" Margin="0,8,0,0" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="6" Background="White">
            <ListBox x:Name="LstGroups" MinHeight="180" BorderThickness="0" Background="Transparent"
                     SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="＋ 新建分组" Style="{StaticResource BtnGhost}" Click="BtnNewGroup_Click"/>
            <Button Content="重命名" Margin="8,0,0,0" Style="{StaticResource BtnGhost}"
                    Click="BtnRenameGroup_Click"/>
            <Button Content="删除" Margin="8,0,0,0" Style="{StaticResource BtnGhost}"
                    Click="BtnDeleteGroup_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button Content="确 定" Width="96" Style="{StaticResource BtnPrimary}"
                    Click="BtnOk_Click" IsDefault="True"/>
            <Button Content="取 消" Width="96" Margin="12,0,0,0" Style="{StaticResource BtnGhost}"
                    Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
