<Window x:Class="ProjectRecorder.ShiftPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="补录：选择日期与班次"
        Width="400" SizeToContent="Height" MaxHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
    <StackPanel Margin="20">
        <TextBlock Text="补录只需要选择当前班次之前的日期与班次，导出明细会标记为“补录”。"
                   FontSize="12" Foreground="#6B7280" TextWrapping="Wrap"/>

        <TextBlock Text="日期 *" FontSize="13" FontWeight="Bold" Foreground="#374151" Margin="0,14,0,0"/>
        <DatePicker x:Name="DtDate" Height="34" Margin="0,8,0,0"
                    HorizontalContentAlignment="Stretch"
                    SelectedDateChanged="DtDate_SelectedDateChanged"/>

        <TextBlock Text="班次 *" FontSize="13" FontWeight="Bold" Foreground="#374151" Margin="0,14,0,0"/>
        <ComboBox x:Name="CmbShift" Height="34" Margin="0,8,0,0" VerticalContentAlignment="Center"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
            <Button Content="确 定" Width="96" Style="{StaticResource BtnPrimary}" Click="BtnOk_Click" IsDefault="True"/>
            <Button Content="取 消" Width="96" Margin="12,0,0,0" Style="{StaticResource BtnGhost}" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
