<Window x:Class="ProjectRecorder.SetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置密码" Width="420" SizeToContent="Height" MaxHeight="600"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F1F5F9" Icon="app.ico">
    <Border Background="White" CornerRadius="12" Padding="30,24" Margin="18"
            BorderBrush="#E5E7EB" BorderThickness="1">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="请设置密码" FontSize="15" FontWeight="Bold" Foreground="#111827"/>

            <TextBlock Text="密码：" FontSize="13" Foreground="#374151" Margin="0,14,0,6"/>
            <PasswordBox x:Name="PwdBox" Height="34"/>

            <TextBlock Text="确认密码：" FontSize="13" Foreground="#374151" Margin="0,10,0,6"/>
            <PasswordBox x:Name="PwdConfirm" Height="34"/>

            <TextBlock x:Name="TxtError" Foreground="#DC2626" FontSize="12" Margin="0,6,0,0"
                       TextWrapping="Wrap"/>

            <Button x:Name="BtnSet" Content="确定并进入" Height="38" Margin="0,14,0,0"
                    Style="{StaticResource BtnPrimary}" Click="BtnSet_Click" IsDefault="True"/>
        </StackPanel>
    </Border>
</Window>
