<?xml version="1.0" encoding="utf-8"?>
<!-- Shell 语法高亮：VS Code Dark+ 配色（AvalonEdit 内置只有 PowerShell，没有 sh/bash）。
     control（if/for/do…）= 紫 #C586C0，storage（local/export…）= 蓝 #569CD6，
     内建命令/函数 = 黄 #DCDCAA，变量 #9CDCFE，注释绿 / 字符串橙 / 数字浅绿。 -->
<SyntaxDefinition name="Bash" extensions=".sh;.bash" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
	<Color name="Comment" foreground="#6A9955" exampleText="# 注释" />
	<Color name="String" foreground="#CE9178" exampleText="some text" />
	<Color name="Control" foreground="#C586C0" exampleText="if" />
	<Color name="Storage" foreground="#569CD6" exampleText="local" />
	<Color name="Builtin" foreground="#DCDCAA" exampleText="echo" />
	<Color name="Function" foreground="#DCDCAA" exampleText="my_func()" />
	<Color name="Variable" foreground="#9CDCFE" exampleText="$HOME" />
	<Color name="Number" foreground="#B5CEA8" exampleText="123" />

	<RuleSet>
		<Span color="Comment">
			<Begin>\#</Begin>
		</Span>

		<Span color="String">
			<Begin>'</Begin>
			<End>'</End>
		</Span>
		<Span color="String">
			<Begin>"</Begin>
			<End>"</End>
			<RuleSet>
				<Span begin="\\" end="." />
				<Rule color="Variable">
					\$[A-Za-z_][A-Za-z0-9_]*
				</Rule>
			</RuleSet>
		</Span>

		<Rule color="Function">
			\b[A-Za-z_][A-Za-z0-9_]*(?=\s*\(\s*\))
		</Rule>
		<Rule color="Variable">
			\$\{[A-Za-z_][A-Za-z0-9_]*\}|\$[A-Za-z_][A-Za-z0-9_]*|\$[0-9@*#?$!\-]
		</Rule>

		<Keywords color="Control">
			<Word>if</Word>
			<Word>then</Word>
			<Word>else</Word>
			<Word>elif</Word>
			<Word>fi</Word>
			<Word>case</Word>
			<Word>esac</Word>
			<Word>for</Word>
			<Word>select</Word>
			<Word>while</Word>
			<Word>until</Word>
			<Word>do</Word>
			<Word>done</Word>
			<Word>in</Word>
			<Word>function</Word>
			<Word>time</Word>
			<Word>coproc</Word>
			<Word>break</Word>
			<Word>continue</Word>
			<Word>return</Word>
			<Word>exit</Word>
		</Keywords>

		<Keywords color="Storage">
			<Word>local</Word>
			<Word>export</Word>
			<Word>declare</Word>
			<Word>readonly</Word>
			<Word>typeset</Word>
		</Keywords>

		<Keywords color="Builtin">
			<Word>echo</Word>
			<Word>printf</Word>
			<Word>read</Word>
			<Word>cd</Word>
			<Word>pwd</Word>
			<Word>pushd</Word>
			<Word>popd</Word>
			<Word>dirs</Word>
			<Word>type</Word>
			<Word>hash</Word>
			<Word>ulimit</Word>
			<Word>umask</Word>
			<Word>wait</Word>
			<Word>jobs</Word>
			<Word>bg</Word>
			<Word>fg</Word>
			<Word>getopts</Word>
			<Word>let</Word>
			<Word>test</Word>
			<Word>true</Word>
			<Word>false</Word>
			<Word>source</Word>
			<Word>eval</Word>
			<Word>exec</Word>
			<Word>set</Word>
			<Word>unset</Word>
			<Word>alias</Word>
			<Word>shift</Word>
			<Word>trap</Word>
			<Word>sudo</Word>
			<Word>apt</Word>
			<Word>apt-get</Word>
			<Word>yum</Word>
			<Word>dnf</Word>
			<Word>brew</Word>
			<Word>pip</Word>
			<Word>pip3</Word>
			<Word>python</Word>
			<Word>python3</Word>
			<Word>node</Word>
			<Word>npm</Word>
			<Word>git</Word>
			<Word>curl</Word>
			<Word>wget</Word>
			<Word>ssh</Word>
			<Word>scp</Word>
			<Word>rsync</Word>
			<Word>tar</Word>
			<Word>zip</Word>
			<Word>unzip</Word>
			<Word>make</Word>
			<Word>docker</Word>
			<Word>kubectl</Word>
			<Word>systemctl</Word>
			<Word>service</Word>
			<Word>nohup</Word>
			<Word>sleep</Word>
			<Word>date</Word>
			<Word>cat</Word>
			<Word>head</Word>
			<Word>tail</Word>
			<Word>less</Word>
			<Word>more</Word>
			<Word>grep</Word>
			<Word>sed</Word>
			<Word>awk</Word>
			<Word>cut</Word>
			<Word>sort</Word>
			<Word>uniq</Word>
			<Word>wc</Word>
			<Word>tr</Word>
			<Word>find</Word>
			<Word>xargs</Word>
			<Word>which</Word>
			<Word>whoami</Word>
			<Word>id</Word>
			<Word>hostname</Word>
			<Word>uname</Word>
			<Word>df</Word>
			<Word>du</Word>
			<Word>free</Word>
			<Word>top</Word>
			<Word>kill</Word>
			<Word>pkill</Word>
			<Word>killall</Word>
			<Word>chmod</Word>
			<Word>chown</Word>
			<Word>chgrp</Word>
			<Word>ln</Word>
			<Word>cp</Word>
			<Word>mv</Word>
			<Word>rm</Word>
			<Word>mkdir</Word>
			<Word>rmdir</Word>
			<Word>touch</Word>
			<Word>stat</Word>
			<Word>file</Word>
			<Word>basename</Word>
			<Word>dirname</Word>
			<Word>realpath</Word>
			<Word>tee</Word>
			<Word>diff</Word>
			<Word>patch</Word>
			<Word>env</Word>
			<Word>printenv</Word>
		</Keywords>

		<Rule color="Number">
			\b\d+\b
		</Rule>
	</RuleSet>
</SyntaxDefinition>