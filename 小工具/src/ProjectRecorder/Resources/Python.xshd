<?xml version="1.0" encoding="utf-8"?>
<!-- Python 语法高亮：VS Code Dark+ 配色。
     control（if/for/return…）= 紫 #C586C0，def/class/and/or/not… = 蓝 #569CD6，
     函数/方法调用与装饰器 = 黄 #DCDCAA，注释绿 / 字符串橙 / 数字浅绿，与 VS Code 默认深色一致。 -->
<SyntaxDefinition name="PythonDark" extensions=".py;.pyw" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
	<Color name="Comment" foreground="#6A9955" exampleText="# comment" />
	<Color name="String" foreground="#CE9178" exampleText="name = 'abc'" />
	<Color name="Function" foreground="#DCDCAA" exampleText="def Hello()" />
	<Color name="Number" foreground="#B5CEA8" exampleText="3.1415" />
	<Color name="Control" foreground="#C586C0" exampleText="if" />
	<Color name="Keyword" foreground="#569CD6" exampleText="def" />

	<RuleSet>
		<Span color="Comment">
			<Begin>\#</Begin>
		</Span>

		<Span color="String" multiline="true">
			<Begin>'''</Begin>
			<End>'''</End>
		</Span>
		<Span color="String" multiline="true">
			<Begin>"""</Begin>
			<End>"""</End>
		</Span>

		<Span color="String">
			<Begin>"</Begin>
			<End>"</End>
			<RuleSet>
				<Span begin="\\" end="."/>
			</RuleSet>
		</Span>
		<Span color="String">
			<Begin>'</Begin>
			<End>'</End>
			<RuleSet>
				<Span begin="\\" end="."/>
			</RuleSet>
		</Span>

		<!-- 装饰器：@ 本身保持默认色，只高亮名字（VSCode 里装饰器名是黄色的函数色） -->
		<Rule color="Function">
			(?&lt;=@)[A-Za-z_][A-Za-z0-9_.]*
		</Rule>

		<Keywords color="Control">
			<Word>if</Word>
			<Word>elif</Word>
			<Word>else</Word>
			<Word>for</Word>
			<Word>while</Word>
			<Word>try</Word>
			<Word>except</Word>
			<Word>finally</Word>
			<Word>with</Word>
			<Word>return</Word>
			<Word>import</Word>
			<Word>from</Word>
			<Word>as</Word>
			<Word>raise</Word>
			<Word>break</Word>
			<Word>continue</Word>
			<Word>yield</Word>
			<Word>async</Word>
			<Word>await</Word>
			<Word>match</Word>
			<Word>case</Word>
		</Keywords>

		<Keywords color="Keyword">
			<Word>def</Word>
			<Word>class</Word>
			<Word>and</Word>
			<Word>or</Word>
			<Word>not</Word>
			<Word>in</Word>
			<Word>is</Word>
			<Word>lambda</Word>
			<Word>global</Word>
			<Word>nonlocal</Word>
			<Word>del</Word>
			<Word>pass</Word>
			<Word>assert</Word>
			<Word>exec</Word>
			<Word>print</Word>
			<Word>False</Word>
			<Word>True</Word>
			<Word>None</Word>
			<Word>self</Word>
			<Word>super</Word>
		</Keywords>

		<Rule color="Function">
			\b
			[\d\w_]+  # an identifier
			(?=\s*\() # followed by (
		</Rule>
		<Rule color="Number">
			\b0[xX][0-9a-fA-F]+  # hex number
			(	\b\d+(\.[0-9]+)?   #number with optional floating point
			|	\.[0-9]+           #or just starting with floating point
			)
			([eE][+-]?[0-9]+)? # optional exponent
		</Rule>
	</RuleSet>
</SyntaxDefinition>