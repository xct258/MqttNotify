<Window x:Class="ProjectRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="clr-namespace:ProjectRecorder.Panels"
        xmlns:views="clr-namespace:ProjectRecorder.Views"
        Title="" Height="660" Width="980" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC" Icon="app.ico">
    <Window.Resources>

        <!-- 通用主页：功能卡片入口按钮（与工作量工序卡片同尺寸/靠左自适应排列） -->
        <Style x:Key="GeneralCard" TargetType="Button">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="200"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="#E5E7EB"
                                BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD"/>
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 主体：左侧常驻（通用模块 + 项目列表），右侧为选中项的面板 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：通用模块 + 项目列表（右键排序/删除） -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB"
                    BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 主页：功能卡片入口 -->
                    <RadioButton x:Name="BtnHome" Grid.Row="0" Content="主页"
                                 GroupName="SideModule" Style="{StaticResource TabButton}"
                                 HorizontalAlignment="Stretch" Margin="8,8,8,4"
                                 Click="BtnHome_Click"/>

                    <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,10">
                        <TextBlock Text="项目" FontSize="14" FontWeight="Bold" Foreground="#111827"/>
                    </Border>

                    <Grid Grid.Row="2">
                        <TextBlock x:Name="TxtProjectEmpty" Text="暂无项目，点下方“＋ 添加项目”"
                                   Style="{StaticResource EmptyText}" TextWrapping="Wrap"
                                   VerticalAlignment="Bottom" Margin="10,10,10,12" Visibility="Collapsed"/>
                        <ListBox x:Name="LstProjects" SelectionMode="Single"
                                 Style="{StaticResource CleanList}" Padding="8"
                                 SelectionChanged="LstProjects_SelectionChanged"
                                 PreviewMouseRightButtonDown="LstProjects_RightButtonDown"
                                 PreviewMouseRightButtonUp="ListBlankUp"
                                 ScrollViewer.CanContentScroll="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ContextMenu>
                                <ContextMenu Opened="ProjectsMenu_Opened">
                                    <MenuItem x:Name="MenuMoveProjectUp" Header="上移" Click="MenuMoveProjectUp_Click"/>
                                    <MenuItem x:Name="MenuMoveProjectDown" Header="下移" Click="MenuMoveProjectDown_Click"/>
                                    <MenuItem x:Name="MenuDeleteProject" Header="删除该项目" Click="MenuDeleteProject_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,3" Padding="10,8" Style="{StaticResource CardBorder}">
                                        <TextBlock Text="{Binding}" FontSize="14" FontWeight="Bold" Foreground="#1F2937"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Button x:Name="BtnAddProject" Grid.Row="3" Content="＋ 添加项目" Height="34" Margin="10"
                            Style="{StaticResource BtnGhost}" Click="BtnAdd_Click"/>
                </Grid>
            </Border>

            <!-- 右：项目面板 -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB"
                    BorderThickness="1" CornerRadius="10">
                <Grid>
                    <TextBlock x:Name="TxtNoProject" Text="请从左侧选择项目" Style="{StaticResource EmptyText}"/>

                    <Grid x:Name="PanelProject" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 面板头：项目=工序/工作量/快捷路径 标签；通用功能=返回 + 标题 -->
                        <Border Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="14,10">
                            <Grid>
                                <StackPanel x:Name="ProjectTabs" Orientation="Horizontal">
                                    <RadioButton x:Name="BtnTabProcess" Content="工 序" Margin="0"
                                                 GroupName="ProjectTabs" Style="{StaticResource TabButton}"
                                                 Click="TabProcess_Click"/>
                                    <RadioButton x:Name="BtnTabWorkload" Content="工作量" Margin="8,0,0,0"
                                                 GroupName="ProjectTabs" Style="{StaticResource TabButton}"
                                                 Click="TabWorkload_Click"/>
                                    <RadioButton x:Name="BtnTabShortcuts" Content="快捷路径" Margin="8,0,0,0"
                                                 GroupName="ProjectTabs" Style="{StaticResource TabButton}"
                                                 Click="TabShortcuts_Click"/>
                                </StackPanel>
                                <StackPanel x:Name="PageHeader" Orientation="Horizontal" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtPageTitle" FontSize="15" FontWeight="Bold"
                                               Foreground="#111827" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 通用主页：功能卡片入口（点进去是各功能独立整页） -->
                        <Grid x:Name="ViewGeneralHome" Grid.Row="1" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <panels:AdaptiveWrapPanel Margin="12,8">
                                    <Button Style="{StaticResource GeneralCard}" Click="GTabExport_Click">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="导出工作量" FontSize="16" FontWeight="Bold"
                                                       Foreground="#111827" HorizontalAlignment="Center"
                                                       TextAlignment="Center" TextWrapping="Wrap"/>
                                            <TextBlock Text="按日期导出 Excel 工作量合计" FontSize="12" Foreground="#6B7280"
                                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GeneralCard}" Click="GTabMindMap_Click">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="思维导图" FontSize="16" FontWeight="Bold"
                                                       Foreground="#111827" HorizontalAlignment="Center"
                                                       TextAlignment="Center" TextWrapping="Wrap"/>
                                            <TextBlock Text="梳理思路，可导出图片 / YAML" FontSize="12" Foreground="#6B7280"
                                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GeneralCard}" Click="GTabNote_Click">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="笔记" FontSize="16" FontWeight="Bold"
                                                       Foreground="#111827" HorizontalAlignment="Center"
                                                       TextAlignment="Center" TextWrapping="Wrap"/>
                                            <TextBlock Text="随手记录，自动加密保存" FontSize="12" Foreground="#6B7280"
                                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GeneralCard}" Click="GTabFiles_Click">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="加密文件" FontSize="16" FontWeight="Bold"
                                                       Foreground="#111827" HorizontalAlignment="Center"
                                                       TextAlignment="Center" TextWrapping="Wrap"/>
                                            <TextBlock Text="导入即 AES-256 加密；md / sh / py 可在线编辑" FontSize="12"
                                                       Foreground="#6B7280" TextWrapping="Wrap" TextAlignment="Center"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </panels:AdaptiveWrapPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- 工序（独立 UserControl，逻辑见 Views/ProcessView） -->
                        <views:ProcessView x:Name="ViewProcessTab" Grid.Row="1" Visibility="Collapsed"/>

                        <!-- 工作量（独立 UserControl，逻辑见 Views/WorkloadView） -->
                        <views:WorkloadView x:Name="ViewWorkloadTab" Grid.Row="1" Visibility="Collapsed"/>

                        <!-- 通用入口：导出合计（独立 UserControl，逻辑见 Views/ExportView） -->
                        <views:ExportView x:Name="ViewExportTab" Grid.Row="1" Visibility="Collapsed"/>

                        <!-- 通用入口：快捷路径（独立 UserControl，逻辑见 Views/ShortcutView） -->
                        <views:ShortcutView x:Name="ViewShortcutTab" Grid.Row="1" Visibility="Collapsed"/>

                        <!-- 通用入口：笔记（独立 UserControl，逻辑见 Views/NoteView） -->
                        <views:NoteView x:Name="ViewNoteTab" Grid.Row="1" Visibility="Collapsed"/>

                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 状态栏：记住登录开关 + 无操作自动退出倒计时 -->
        <Grid Grid.Row="1" Margin="2,8,2,0">
            <CheckBox x:Name="ChkAutoLogin" Content="记住登录（自动登录、取消 120 秒自动退出）"
                      FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"
                      Checked="ChkAutoLogin_Changed" Unchecked="ChkAutoLogin_Changed"
                      ToolTip="勾选后将在用户文件夹保存加密的登录信息，下次免登录且不自动退出；取消勾选则恢复登录页与 120 秒自动退出"/>
            <TextBlock x:Name="TxtCountdown" FontSize="12" Foreground="#6B7280"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
