<Window x:Class="ProjectRecorder.DuplicateFileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件已存在" Height="250" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
    <StackPanel Margin="20">
        <TextBlock x:Name="TxtMessage" FontSize="13" Foreground="#374151" TextWrapping="Wrap"/>
        <CheckBox x:Name="ChkApplyAll" Content="后续同名文件都这样处理" Margin="0,12,0,0"
                  FontSize="12" Foreground="#6B7280"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="覆盖旧文件" Width="96" Style="{StaticResource BtnPrimary}" Click="BtnOverwrite_Click"/>
            <Button Content="保留两者" Width="96" Margin="12,0,0,0" Style="{StaticResource BtnGhost}" Click="BtnKeepBoth_Click"/>
            <Button Content="跳 过" Width="96" Margin="12,0,0,0" Style="{StaticResource BtnGhost}" Click="BtnSkip_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
