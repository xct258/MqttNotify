<Window x:Class="ProjectRecorder.ImageViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="查看图片" Height="640" Width="860" MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,8,10,0" VerticalAlignment="Center">
            <Button x:Name="BtnZoomOut" Content="－" Width="30" Height="28" Style="{StaticResource BtnStep}"
                    Click="BtnZoomOut_Click" ToolTip="缩小"/>
            <TextBlock x:Name="TxtZoom" Text="100%" Width="56" TextAlignment="Center" VerticalAlignment="Center"
                       FontSize="13" Foreground="#374151" Margin="4,0"/>
            <Button x:Name="BtnZoomIn" Content="＋" Width="30" Height="28" Style="{StaticResource BtnStep}"
                    Click="BtnZoomIn_Click" ToolTip="放大"/>
            <Button x:Name="BtnFit" Content="适应窗口" Height="28" Margin="8,0,0,0" Padding="10,0"
                    Style="{StaticResource BtnGhost}" Click="BtnFit_Click"/>
            <Button x:Name="BtnActual" Content="原图 1:1" Height="28" Margin="6,0,0,0" Padding="10,0"
                    Style="{StaticResource BtnGhost}" Click="BtnActual_Click"/>
            <StackPanel x:Name="NavPanel" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                        Visibility="Collapsed">
                <Button x:Name="BtnPrev" Content="‹ 上一张" Height="28" Padding="10,0"
                        Style="{StaticResource BtnGhost}" Click="BtnPrev_Click"/>
                <TextBlock x:Name="TxtCounter" Text="1/1" MinWidth="44" TextAlignment="Center" VerticalAlignment="Center"
                           FontSize="13" Foreground="#374151" Margin="6,0"/>
                <Button x:Name="BtnNext" Content="下一张 ›" Height="28" Padding="10,0"
                        Style="{StaticResource BtnGhost}" Click="BtnNext_Click"/>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Margin="10,8" Background="White" BorderBrush="#E5E7EB"
                BorderThickness="1" CornerRadius="8">
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Cursor="Hand" PreviewMouseWheel="Scroller_MouseWheel"
                          SizeChanged="Scroller_SizeChanged"
                          PreviewMouseLeftButtonDown="Scroller_DragStart"
                          PreviewMouseMove="Scroller_DragMove"
                          PreviewMouseLeftButtonUp="Scroller_DragEnd">
                <Image x:Name="ImgFull" Stretch="None" Margin="8" RenderOptions.BitmapScalingMode="HighQuality"/>
            </ScrollViewer>
        </Border>
        <TextBlock Grid.Row="2" Text="滚轮缩放图片，按住图片拖动平移查看" FontSize="12" Foreground="#9CA3AF"
                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
    </Grid>
</Window>
