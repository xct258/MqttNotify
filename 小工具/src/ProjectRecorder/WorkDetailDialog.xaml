<Window x:Class="ProjectRecorder.WorkDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="执行明细" Height="470" Width="430"
        MinHeight="320" MinWidth="360"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtHead" FontSize="14" FontWeight="Bold" Foreground="#111827"
                   TextWrapping="Wrap"/>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="4,0,4,6">
                <TextBlock Text="时间" FontSize="12" Foreground="#6B7280"/>
                <TextBlock Text="数量" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Right"/>
            </Grid>
            <ListBox Grid.Row="1" x:Name="LstRows" Style="{StaticResource CleanList}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,3" Padding="10,8" Style="{StaticResource CardBorder}">
                            <Grid>
                                <TextBlock Text="{Binding Time}" FontSize="14" Foreground="#1F2937"/>
                                <TextBlock Text="{Binding Qty}" FontSize="14" FontWeight="Bold"
                                           Foreground="#2563EB" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <TextBlock x:Name="TxtTotal" Grid.Row="2" Margin="4,8,4,0" FontSize="13"
                   Foreground="#374151"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="关 闭" Width="96" Style="{StaticResource BtnGhost}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
