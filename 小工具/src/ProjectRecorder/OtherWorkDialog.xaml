<Window x:Class="ProjectRecorder.OtherWorkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加其它工作量" Height="280" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
    <StackPanel Margin="20">
        <TextBlock Text="项目 *" FontSize="13" FontWeight="Bold" Foreground="#374151"/>
        <TextBox x:Name="TxtProject" Height="32" Margin="0,8,0,0"
                 VerticalContentAlignment="Center" MaxLength="60"
                 ToolTip="例如：参加比赛、打扫卫生"/>

        <TextBlock Text="时间（小时）*" FontSize="13" FontWeight="Bold" Foreground="#374151"
                   Margin="0,16,0,0"/>
        <TextBox x:Name="TxtHours" Height="32" Margin="0,8,0,0"
                 VerticalContentAlignment="Center" MaxLength="6" Text="1"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
            <Button Content="确 定" Width="96" Style="{StaticResource BtnPrimary}"
                    Click="BtnOk_Click" IsDefault="True"/>
            <Button Content="取 消" Width="96" Margin="12,0,0,0" Style="{StaticResource BtnGhost}"
                    Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
