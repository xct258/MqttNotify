<UserControl x:Class="ProjectRecorderLite.Views.ShortcutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 快捷路径：左列文件夹单击打开，右列网址单击复制 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="14,10">
            <TextBlock x:Name="TxtShortcutHint"
                       Text="文件夹：单击用资源管理器打开；网址：单击打开手动复制窗口（全选后按 Ctrl+C）"
                       FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="0,0,120,0"/>
            <Button x:Name="BtnAddShortcut" Content="＋ 添加" HorizontalAlignment="Right"
                    Style="{StaticResource BtnPrimary}" Click="BtnAddShortcut_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 文件夹 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="文件夹（单击打开）" FontSize="13" FontWeight="Bold"
                               Foreground="#374151" VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="1">
                    <TextBlock x:Name="TxtFolderShortcutEmpty" Text="暂无文件夹快捷方式"
                               Style="{StaticResource EmptyText}" TextWrapping="Wrap"
                               Margin="10" Visibility="Collapsed"/>
                    <ListBox x:Name="LstFolderShortcuts" SelectionMode="Single"
                             Style="{StaticResource CleanList}"
                             PreviewMouseRightButtonDown="LstShortcuts_RightButtonDown"
                             PreviewMouseRightButtonUp="ListBlankUp"
                             ScrollViewer.CanContentScroll="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="删除该文件夹" Click="MenuDeleteFolderShortcut_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,3" Padding="10,8"
                                        Style="{StaticResource CardBorder}"
                                        Cursor="Hand" ToolTip="单击用资源管理器打开"
                                        MouseLeftButtonUp="ShortcutFolder_Click">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="14"
                                                   FontWeight="Bold" Foreground="#1F2937"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FolderPath}" FontSize="11"
                                                   Foreground="#6B7280"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>

            <!-- 网址 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="网址（单击复制）" FontSize="13" FontWeight="Bold"
                               Foreground="#374151" VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="1">
                    <TextBlock x:Name="TxtUrlShortcutEmpty" Text="暂无网址快捷方式"
                               Style="{StaticResource EmptyText}" TextWrapping="Wrap"
                               Margin="10" Visibility="Collapsed"/>
                    <ListBox x:Name="LstUrlShortcuts" SelectionMode="Single"
                             Style="{StaticResource CleanList}"
                             PreviewMouseRightButtonDown="LstShortcuts_RightButtonDown"
                             PreviewMouseRightButtonUp="ListBlankUp"
                             ScrollViewer.CanContentScroll="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="手动复制网址" Click="MenuManualCopyUrlShortcut_Click"/>
                                <MenuItem Header="删除该网址" Click="MenuDeleteUrlShortcut_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,3" Padding="10,8"
                                        Style="{StaticResource CardBorder}"
                                        Cursor="Hand" ToolTip="单击打开手动复制窗口"
                                        MouseLeftButtonUp="ShortcutUrl_Click">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="14"
                                                   FontWeight="Bold" Foreground="#1F2937"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FolderPath}" FontSize="11"
                                                   Foreground="#2563EB"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
