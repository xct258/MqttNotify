<Window x:Class="ProjectRecorderLite.ManualCopyDialog" FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手动复制网址" Height="260" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
    <StackPanel Margin="20">
        <TextBlock Text="网址已全选，按 Ctrl+C 复制（本工具不会自动写入剪贴板）" FontSize="13"
                   FontWeight="Bold" Foreground="#374151" TextWrapping="Wrap"/>
        <TextBox x:Name="TxtContent" Height="90" Margin="0,8,0,0" TextWrapping="Wrap"
                 IsReadOnly="True" VerticalScrollBarVisibility="Auto" Padding="6,4"
                 GotFocus="TxtContent_GotFocus"/>
        <Button Content="关 闭" Width="96" Margin="0,20,0,0" HorizontalAlignment="Center"
                Style="{StaticResource BtnGhost}" Click="BtnClose_Click" IsCancel="True"/>
    </StackPanel>
</Window>
