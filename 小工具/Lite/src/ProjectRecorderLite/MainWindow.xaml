<Window x:Class="ProjectRecorderLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ProjectRecorderLite.Views"
        Title="小工具 Lite - 项目与快捷路径" Height="660" Width="980"
        MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC" Icon="app.ico">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左：项目列表（右键排序/删除） -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB"
                BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,10">
                    <TextBlock Text="项目" FontSize="14" FontWeight="Bold" Foreground="#111827"/>
                </Border>

                <Grid Grid.Row="1">
                    <TextBlock x:Name="TxtProjectEmpty" Text="暂无项目，点下方“＋ 添加项目”"
                               Style="{StaticResource EmptyText}" TextWrapping="Wrap"
                               VerticalAlignment="Bottom" Margin="10,10,10,12" Visibility="Collapsed"/>
                    <ListBox x:Name="LstProjects" SelectionMode="Single"
                             Style="{StaticResource CleanList}" Padding="8"
                             SelectionChanged="LstProjects_SelectionChanged"
                             PreviewMouseRightButtonDown="LstProjects_RightButtonDown"
                             PreviewMouseRightButtonUp="ListBlankUp"
                             ScrollViewer.CanContentScroll="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ContextMenu>
                            <ContextMenu Opened="ProjectsMenu_Opened">
                                <MenuItem x:Name="MenuMoveProjectUp" Header="上移" Click="MenuMoveProjectUp_Click"/>
                                <MenuItem x:Name="MenuMoveProjectDown" Header="下移" Click="MenuMoveProjectDown_Click"/>
                                <MenuItem x:Name="MenuDeleteProject" Header="删除该项目" Click="MenuDeleteProject_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,3" Padding="10,8" Style="{StaticResource CardBorder}">
                                    <TextBlock Text="{Binding}" FontSize="14" FontWeight="Bold" Foreground="#1F2937"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Button x:Name="BtnAddProject" Grid.Row="2" Content="＋ 添加项目" Height="34" Margin="10"
                        Style="{StaticResource BtnGhost}" Click="BtnAdd_Click"/>
            </Grid>
        </Border>

        <!-- 右：快捷路径面板 -->
        <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB"
                BorderThickness="1" CornerRadius="10">
            <Grid>
                <TextBlock x:Name="TxtNoProject" Text="请从左侧选择项目" Style="{StaticResource EmptyText}"/>

                <Grid x:Name="PanelProject" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="14,10">
                        <TextBlock x:Name="TxtProjectTitle" FontSize="15" FontWeight="Bold"
                                   Foreground="#111827" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <views:ShortcutView x:Name="ViewShortcut" Grid.Row="1"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
