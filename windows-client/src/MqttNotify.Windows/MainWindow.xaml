<Window x:Class="MqttNotify.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MQTT 提醒"
        Icon="Assets/MqttNotify.ico"
        Height="700" Width="920" MinHeight="580" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5FB"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================ 顶部状态 ============================ -->
        <Border Grid.Row="0" Margin="20,18,20,0" CornerRadius="18"
                Background="{StaticResource HeroGradient}"
                Effect="{StaticResource HeroShadow}">
            <Grid Margin="26,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="56" Height="56" CornerRadius="17"
                        Background="#26FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1"
                        VerticalAlignment="Center">
                    <Path Data="M2,12 L22,2 L14,22 L11,13 Z"
                          Fill="White" Stretch="Uniform" Margin="14" />
                </Border>

                <StackPanel Grid.Column="1" Margin="18,0,24,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Margin="0,0,9,0" VerticalAlignment="Center"
                                 Stroke="White" StrokeThickness="1"
                                 Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                        <TextBlock Text="{Binding StatusText}" FontSize="24" FontWeight="Bold"
                                   Foreground="White" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusDetail}" Foreground="#E0E7FF"
                               FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="启动接收" Command="{Binding StartCommand}"
                            Style="{StaticResource HeroButton}" Margin="0,0,10,0" />
                    <Button Content="停止接收" Command="{Binding StopCommand}"
                            Style="{StaticResource HeroButton}" Margin="0,0,10,0" />
                    <Button Content="设置" Click="OpenSettings_Click"
                            Style="{StaticResource HeroButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ 主内容：提醒 ============================ -->
        <Grid Grid.Row="1" Margin="20,18,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 连接摘要 -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="16,13">
                    <StackPanel>
                        <TextBlock Text="订阅主题" Foreground="{StaticResource TextMuted}" FontSize="11" />
                        <TextBlock Text="{Binding SubscribeTopicPreview}" Foreground="{StaticResource TextPrimary}"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,13">
                    <StackPanel>
                        <TextBlock Text="Broker 地址" Foreground="{StaticResource TextMuted}" FontSize="11" />
                        <TextBlock Text="{Binding EndpointPreview}" Foreground="{StaticResource Accent}"
                                   FontSize="12.5" FontWeight="SemiBold" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 最近提醒 -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="最近提醒" Style="{StaticResource SectionHeader}" Margin="0" />
                            <TextBlock Text="仅本次运行内保留，最多 100 条（不落盘）" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <Button Content="清空" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding ClearAlertsCommand}"
                                Style="{StaticResource GhostButton}" />
                    </Grid>

                    <Grid>
                        <ListBox ItemsSource="{Binding Alerts}"
                                 BorderThickness="0" Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14,12" CornerRadius="12"
                                            Background="#F8FAFC" BorderBrush="#E8EDF6" BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Padding="8,2" CornerRadius="6"
                                                        Background="{StaticResource AccentSoft}">
                                                    <TextBlock Text="{Binding Topic}" FontSize="10"
                                                               Foreground="{StaticResource Accent}"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                                </Border>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}"
                                                             VerticalAlignment="Center" Margin="0,0,7,0" />
                                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}"
                                                               Text="{Binding ReceivedAt, StringFormat='{}{0:HH:mm:ss}'}" />
                                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}"
                                                               Margin="8,0,0,0"
                                                               Text="{Binding TaskId, StringFormat='#{0}'}" />
                                                </StackPanel>
                                            </DockPanel>

                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       TextWrapping="Wrap" Margin="0,9,0,0" />
                                            <TextBlock Text="{Binding Body}" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       FontSize="12.5" LineHeight="19" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAlerts}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="56" Height="56" CornerRadius="17" Background="{StaticResource AccentSoft}"
                                    HorizontalAlignment="Center">
                                <Path Data="M2,12 L22,2 L14,22 L11,13 Z" Fill="{StaticResource Accent}"
                                      Stretch="Uniform" Margin="15" />
                            </Border>
                            <TextBlock Text="还没有收到提醒" Foreground="{StaticResource TextMuted}"
                                       Margin="0,12,0,0" HorizontalAlignment="Center" />
                            <TextBlock Text="连接成功并收到推送后会显示在这里" Foreground="#CBD5E1"
                                       FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
