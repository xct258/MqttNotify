<Application x:Class="MqttNotify.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MqttNotify.Windows.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- 关闭主窗口只收进托盘，真正退出由托盘菜单触发，所以不能是 OnMainWindowClose -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:ConnectionStatusToBrushConverter x:Key="StatusBrush" />

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#37474F" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#546E7A" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#757575" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Application.Resources>
</Application>
