<Project Sdk="Microsoft.NET.Sdk">

  <!--
    图标生成器。刻意不加入 MqttNotify.sln：它只在需要重新生成图标时手动跑一次，
    日常 build / test 不该为它付出代价。

    用法：dotnet run (project: tools/icon-gen) 后面跟输出路径，即
          src/MqttNotify.Windows/Assets/MqttNotify.ico
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>icon-gen</AssemblyName>
    <RootNamespace>IconGen</RootNamespace>
  </PropertyGroup>

</Project>
